<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>Document</title>
    <style>
        @media (min-width:580px){
            body {
                margin: 0;
                padding: 10px;
                display: flex;
                justify-content: center; 
                align-items: center;    
                min-height: 100vh;      
                box-sizing: border-box;
            }
            .auth-wrapper{
                border-radius: 10px;
                display:inline-block;
                margin:auto;
                box-shadow:4px 4px 20px rgb(134, 133, 133);
            }
        }
    </style>
</head>
<body>
    
    <div class="auth-wrapper p-5">
        <div class="login-card" style="max-width: 500px;">
            <div class="text-center mb-4">
                <h2 class="fw-extrabold" style="font-weight: 800; letter-spacing: 0.5px;">
                    Forget password  <span style="color: var(--tech-blue);">U-LEP</span>
                </h2>
            </div>
            <form action="/ulep/forget-password" method="POST">
                <div class="input-group mb-3">
                    <input type="email" name="email" class="form-control email" placeholder="Enter your email id" required>
                    <button class="btn btn-danger sendotp-btn" onclick="emailLog()" type="button">Send OTP</button>
                </div>
                <div class="input-group otp-input-group d-none">
                    <input type="text" inputmode="numeric" name="otp" class="form-control" id="otp-input" placeholder="000000" maxlength="6" autocomplete="one-time-code">
                    <button class="btn btn-success varify-otp" type="button" onclick="varifyOtp()">Varify OTP</button>
                </div><br>
                <button class="btn btn-primary btn-sm submit" type="submit" disabled>Submit</button>
                
            </form>
            <div class="text-center mt-4 small text-muted">
                New user? <a href="" class="text-decoration-none fw-semibold" style="color: var(--tech-blue);">Create Account</a>
            </div>
        </div>
    </div>

    <script src="/js/functions.js"></script>
</body>
</html>