<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>Document</title>
    <style>
        @media (min-width:580px){
            body {
                margin: 0;
                padding: 10px;
                display: flex;
                justify-content: center; 
                align-items: center;    
                min-height: 100vh;      
                box-sizing: border-box;
            }
            .auth-wrapper{
                border-radius: 10px;
                display:inline-block;
                margin:auto;
                box-shadow:4px 4px 20px rgb(134, 133, 133);
            }
        }
    </style>
</head>
<body>

    <div class="auth-wrapper p-5">
        <div class="login-card" style="max-width: 500px;">
            <div class="text-center mb-4">
                <h2 class="fw-extrabold" style="font-weight: 800; letter-spacing: 0.5px;">
                    Reset password  <span style="color: var(--tech-blue);">U-LEP</span>
                </h2>
                <p class="text-muted">Enter New password for your Account</p>
            </div>
            <form action="/ulep/reset-password/<%= username %>" method="POST" id="reset-password-form">
                <label for="resetPasswordInput1" class="text-muted">New Password</label>
                <div class="input-group mb-4">
                    <input type="password" id="resetPasswordInput1" name="password" class="form-control" placeholder="min 8 characters" minlength="8" required style="border-top-right-radius: 0px !important; border-bottom-right-radius: 0px !important;">
                    <button class="btn btn-outline-secondary" 
                            type="button" 
                            style="background-color: var(--bg-dark); border: 1px solid var(--border-slate); border-left: none; color: #64748b; border-top-right-radius: 10px; border-bottom-right-radius: 10px;">
                        <i class="bi bi-eye" id="toggleLoginEyeIcon"></i>
                    </button>
                </div>
                <label for="resetPasswordInput2" class="text-muted">Confirm Password</label>
                <div class="input-group mb-4">
                    <input type="password" id="resetPasswordInput2" name="confirmPassword" class="form-control" placeholder="min 8 characters" minlength="8" required style="border-top-right-radius: 0px !important; border-bottom-right-radius: 0px !important;">
                    <button class="btn btn-outline-secondary" 
                            type="button" 
                            style="background-color: var(--bg-dark); border: 1px solid var(--border-slate); border-left: none; color: #64748b; border-top-right-radius: 10px; border-bottom-right-radius: 10px;"></button>
                        <i class="bi bi-eye" id="toggleLoginEyeIcon"></i>
                    </button>
                </div>
                <button type="submit" class="form-control btn btn-primary">Submit</button>
                
            </form>
        </div>
    </div>
    
    <script src="/js/reset-password.js"></script>
</body>
</html>